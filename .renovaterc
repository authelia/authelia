{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(build)",
    ":separatePatchReleases",
    "workarounds:doNotUpgradeFromAlpineStableToEdge"
  ],
  "branchPrefixOld": "renovate-",
  "rebaseWhen": "conflicted",
  "ignorePresets": [
    ":prHourlyLimit2",
    ":semanticPrefixFixDepsChoreOthers",
    "workarounds:all"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^docs/netlify\\.toml$/"
      ],
      "matchStrings": [
        "HUGO_VERSION = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "hugo-extended",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/pnpm/get\\.pnpm\\.io/(?<currentDigest>[0-9a-f]{40})/install\\.sh"
      ],
      "depNameTemplate": "pnpm/get.pnpm.io",
      "packageNameTemplate": "https://github.com/pnpm/get.pnpm.io",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "enabledManagers": [
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gomod",
    "kubernetes",
    "npm"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/kube/.+\\.yml$/"
    ]
  },
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": "traefik",
      "matchFileNames": [
        "internal/suites/example/compose/traefik/compose.v2.yml"
      ],
      "allowedVersions": "<3.0.0"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "docker"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github_actions"
      ]
    },
    {
      "matchDatasources": [
        "go"
      ],
      "addLabels": [
        "go"
      ]
    },
    {
      "matchDatasources": [
        "kubernetes"
      ],
      "addLabels": [
        "kubernetes"
      ]
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "addLabels": [
        "javascript"
      ],
      "minimumReleaseAge": "1 day"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "pnpmDedupe"
  ]
}

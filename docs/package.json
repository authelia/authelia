{
  "name": "authelia-website",
  "version": "1.9.0",
  "description": "The Authelia Website",
  "author": "Authelia Contributors",
  "license": "Apache-2.0",
  "scripts": {
    "create": "hugo new",
    "dev": "hugo server --disableFastRender --noHTTPCache",
    "ci": "hugo server --disableFastRender --noHTTPCache --disableLiveReload",
    "lint": "eslint --format visualstudio --no-warn-ignored --fix",
    "build": "hugo --minify --gc",
    "preview": "vite preview --outDir public"
  },
  "dependencies": {
    "@docsearch/css": "5.0.5",
    "@docsearch/js": "5.0.5",
    "@tabler/icons": "3.46.0",
    "@thulite/core": "1.5.9",
    "@thulite/doks-core": "1.9.3",
    "@thulite/images": "3.3.4",
    "@thulite/inline-svg": "1.2.2",
    "@thulite/seo": "2.4.3",
    "bootstrap-icons": "1.13.1",
    "thulite": "2.6.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@eslint/css": "2.0.0",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@fullhuman/postcss-purgecss": "8.0.0",
    "autoprefixer": "10.5.5",
    "basiclightbox": "5.0.4",
    "bootstrap": "5.3.8",
    "clipboard": "2.0.11",
    "eslint": "10.10.0",
    "eslint-formatter-rdjson": "1.0.6",
    "eslint-formatter-visualstudio": "9.0.1",
    "eslint-plugin-prettier": "5.5.6",
    "flexsearch": "0.8.212",
    "postcss": "8.5.28",
    "postcss-cli": "11.0.1",
    "prettier": "3.9.6",
    "vite": "8.2.2"
  },
  "optionalDependencies": {
    "hugo-extended": "0.164.0"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": "11"
  },
  "packageManager": "pnpm@11.25.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
